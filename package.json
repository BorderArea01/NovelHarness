{
  "name": "novel-writer-lan",
  "private": true,
  "type": "module",
  "version": "5.0.0",
  "license": "GPL-3.0-only",
  "repository": { "type": "git", "url": "https://github.com/BorderArea01/NovelHarness.git" },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm run dev -w @novel-writer/server\" \"npm run dev -w @novel-writer/web\"",
    "build": "node --max-old-space-size=384 cloud/selfhost/build.mjs",
    "build:public": "node --max-old-space-size=384 cloud/selfhost/build.mjs",
    "build:legacy": "npm run build -w @novel-writer/shared && npm run build -w @novel-writer/web && npm run build -w @novel-writer/server",
    "start": "node --max-old-space-size=192 cloud/selfhost/server.mjs",
    "start:public": "node --max-old-space-size=192 cloud/selfhost/server.mjs",
    "start:legacy": "node apps/server/dist/index.js",
    "test:public": "node --test cloud/selfhost/identity.test.mjs",
    "test:public:integration": "node --max-old-space-size=192 cloud/selfhost/isolation.test.mjs",
    "test:public:browser": "node --max-old-space-size=192 cloud/selfhost/browser.test.mjs",
    "start:background": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/start-server.ps1",
    "autostart:install": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/install-autostart.ps1",
    "autostart:remove": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/remove-autostart.ps1",
    "typecheck": "npm run build -w @novel-writer/shared && npm run typecheck --workspaces --if-present",
    "lint": "eslint apps packages --max-warnings=0",
    "format": "prettier --write apps packages tests *.ts *.js *.json *.md docs .github",
    "format:check": "prettier --check apps packages tests *.ts *.js *.json *.md docs .github",
    "test": "npm run test -w @novel-writer/server",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@noble/hashes": "1.8.0",
    "@playwright/test": "^1.55.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.34.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8.41.0"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true
  }
}
